{
  "expo": {
    "name": "Chhath Countdown",
    "slug": "chhath-countdown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chhathcountdown",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.see2rakesh.chhathcountdown",
      "supportsTablet": true
    },
    "android": {
      "package": "com.see2rakesh.chhathcountdown",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F0821E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Chhath Countdown",
      "shortName": "Chhath",
      "themeColor": "#D9480F",
      "backgroundColor": "#FFF7EC",
      "lang": "hi"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9480F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/ChathCountDownApp"
    },
    "description": "Chhath Mahaparv 2026 countdown, district-wise arghya timings for Bihar and a daily Sharda Sinha Chhath geet.",
    "backgroundColor": "#FFF7EC",
    "primaryColor": "#D9480F",
    "extra": {
      "songsUrl": "",
      "shareUrl": ""
    }
  }
}